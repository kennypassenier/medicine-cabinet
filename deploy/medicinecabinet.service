# medicinecabinet — the golden unit (AR17), as the homelab's answers shaped it.
#
# StartLimitIntervalSec/Burst belong in [Unit]: in [Service] systemd
# ignores them silently ("Unknown key") and a crash loop stops after five
# tries. Wants= not Requires= for the network, so a slow link after a
# power cut does not park the unit. Type=notify: the unit is active only
# once the service sent READY=1 after binding (W9). ReadWritePaths covers
# the binary's directory too, or self-update verifies, downloads and then
# fails at the swap.
#
# Install: install -D -m755 -o medicinecabinet -g medicinecabinet medicinecabinet /opt/medicinecabinet/bin/medicinecabinet
# (the service must own the binary itself, not only its directory: Linux
# refuses a hard link to a file another user owns, so a root-owned binary
# stops the self-update at the swap — fix-12, kyu on CT 109), copy
# this file to /etc/systemd/system/medicinecabinet.service, create the user
# (medicinecabinet), the state dir (/var/lib/medicinecabinet) and the env file
# (/etc/medicinecabinet/medicinecabinet.env, 0640 root:medicinecabinet), then
# systemctl enable --now medicinecabinet.

[Unit]
Description=medicinecabinet — Medicines, schedules, stock and reminders
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
User=medicinecabinet
Group=medicinecabinet
EnvironmentFile=/etc/medicinecabinet/medicinecabinet.env
WorkingDirectory=/var/lib/medicinecabinet
# feat-backup-1: /run/medicinecabinet/backup.sock, where `medicinecabinet backup-pause`
# reaches the running service; outside the state root, so never archived.
RuntimeDirectory=medicinecabinet
RuntimeDirectoryMode=0700
ExecStartPre=/opt/medicinecabinet/bin/medicinecabinet --check
ExecStart=/opt/medicinecabinet/bin/medicinecabinet
Restart=always
RestartSec=5s
KillSignal=SIGTERM
# Above the service's shutdown_timeout_ms (default 10 s), so N1's bound
# is the one that decides, not systemd's.
TimeoutStopSec=60
# Mirrored so `--check` can warn when the shutdown timeout would outlive it (critic #20).
# Explicit, not the binary's compiled-in default (CF-6 d, 2026-09-06): the
# unit says where the state lives, so a binary built with another default
# still runs against this machine's measured directory.
Environment=MEDICINECABINET_STATE_DIR=/var/lib/medicinecabinet
Environment=MEDICINECABINET_TIMEOUT_STOP_SECS=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/medicinecabinet /var/lib/medicinecabinet-pre-update /opt/medicinecabinet/bin
# S2: the swap needs write access to the binary's OWN directory only; a
# code-execution bug can then replace this service's binary, not latch or
# its neighbours. The rest is systemd's free hardening for a network daemon.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
